{
  "name": "rubylingo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RubyLingo — web app học từ vựng tiếng Anh Cambridge Starters cho bé 7+ (Nhà Vườn Thú Của Bé)",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "npm run typecheck && npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=dist-server/index.js",
    "start": "cross-env NODE_ENV=production node dist-server/index.js",
    "migrate": "tsx server/db/migrate.ts",
    "validate:content": "tsx scripts/validate-content.ts",
    "reset-password": "tsx scripts/reset-password.ts",
    "typecheck": "tsc -p tsconfig.shared.json && tsc -p tsconfig.app.json && tsc -p tsconfig.server.json && tsc -p tsconfig.test.json",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"{src,server,shared,scripts,tests}/**/*.{ts,tsx,json,css}\"",
    "format:check": "prettier --check \"{src,server,shared,scripts,tests}/**/*.{ts,tsx,json,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --reporter=default --reporter=json --outputFile.json=.vitest-report.json && tsx scripts/verify-test-count.ts",
    "test:e2e": "playwright test",
    "ci": "npm run typecheck && npm run lint && npm run validate:content && npm run gen:content-index && npm run gen:theme-colors && npm run test:ci",
    "gen:theme-colors": "tsx scripts/gen-theme-colors.ts",
    "gen:content-index": "tsx scripts/gen-content-index.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^9.4.0",
    "@fastify/helmet": "^11.1.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^7.0.4",
    "@hookform/resolvers": "^3.9.0",
    "@node-rs/argon2": "^2.0.2",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-tooltip": "^1.1.3",
    "@tanstack/react-query": "^5.59.0",
    "better-sqlite3": "^11.3.0",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "fastify-plugin": "^4.5.1",
    "fastify-type-provider-zod": "^1.1.9",
    "framer-motion": "^11.11.9",
    "i18next": "^23.15.1",
    "nanoid": "^5.0.7",
    "pino": "^9.4.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-i18next": "^15.0.2",
    "react-router-dom": "^6.26.2",
    "tailwind-merge": "^2.5.4",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.2",
    "@testing-library/jest-dom": "^6.5.0",
    "@testing-library/react": "^16.0.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0",
    "@typescript-eslint/parser": "^8.8.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "esbuild": "^0.24.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.12",
    "jsdom": "^25.0.1",
    "pino-pretty": "^11.2.2",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  }
}
