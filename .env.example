# =============================================================================
# RubyLingo — biến môi trường
# Sao chép file này thành `.env` rồi điền giá trị thật. KHÔNG commit `.env`.
# =============================================================================

# --- Chạy ở đâu ---
NODE_ENV=development
# ⚠️⚠️ CHẠY TRONG DOCKER THÌ PHẢI LÀ `0.0.0.0`, KHÔNG ĐƯỢC ĐỂ `127.0.0.1`.
#   `127.0.0.1` khiến server chỉ nghe trong LÒNG container ⇒ reverse proxy ở container
#   KHÁC (Traefik/Caddy) KHÔNG tới được ⇒ **502 mà không có lỗi nào trong log ứng dụng**
#   (app vẫn báo "listening" và healthcheck nội bộ vẫn xanh ⇒ hỏng HOÀN TOÀN im lặng).
#   Chỉ để `127.0.0.1` khi server chạy TRỰC TIẾP trên máy, sau một proxy CÙNG máy.
HOST=0.0.0.0
PORT=3000

# --- Cơ sở dữ liệu ---
# Đường dẫn tương đối tính từ gốc dự án. Thư mục `data/` KHÔNG nằm trong static root.
DB_PATH=./data/rubylingo.db

# --- Phiên đăng nhập ---
# BẮT BUỘC đổi ở production. Sinh bằng:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=doi-thanh-mot-chuoi-ngau-nhien-that-dai-o-production
SESSION_TTL_DAYS=90
# Chỉ bật true khi chạy sau HTTPS (production trên VPS). Ở localhost để false.
COOKIE_SECURE=false

# --- Origin công khai (dùng cho CORS/Origin check + link trong email sau này) ---
# Dev: http://localhost:5173   |   Production: https://ten-mien-cua-ban
PUBLIC_ORIGIN=http://localhost:5173

# --- Log ---
# trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# --- Rate limit (chống dò mật khẩu / spam đăng ký) ---
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=1 minute

# --- Tùy chọn: email xác thực + quên mật khẩu (P1 — khi mở công khai) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="RubyLingo <no-reply@example.com>"

# =============================================================================
# NHÓM 12 — DEPLOY BẰNG DOCKER + TRAEFIK (xem `docker-compose.yml` + `deploy/README.md`)
# =============================================================================
# Ba biến dưới đây KHÔNG có giá trị dev: chúng chỉ tồn tại khi deploy. Để TRỐNG có chủ ý —
# `docker-compose.yml` dùng `${TÊN:?…}` nên TRỐNG hay THIẾU đều làm `docker compose up` DỪNG NGAY
# kèm đúng tên biến cần điền. Không thể deploy với cấu hình nửa vời.
#
# (Đây là chỗ DUY NHẤT trong tệp định nghĩa ba biến này, nên không có chuyện hai dòng trùng tên.)
SUBDOMAIN=
DOMAIN_NAME=

# ⚠️⚠️ TRAEFIK_CERTRESOLVER — CHỖ DỄ SAI NHẤT CỦA CẢ QUÁ TRÌNH DEPLOY.
#   Đây KHÔNG phải biến của RubyLingo. Nó là KHOÁ trong `certificatesResolvers.<TÊN>` của cấu hình
#   TĨNH Traefik đã có sẵn trên VPS bạn. Điền SAI tên thì compose VẪN XANH, container VẪN chạy,
#   `/api/health` VẪN "ok" — Traefik chỉ LẶNG LẼ không xin được chứng chỉ ⇒ trình duyệt báo lỗi
#   chứng chỉ, và vì router HTTP đá sang HTTPS nên site coi như chết. `deploy.sh` bước 5 khi đó đỏ
#   với thông báo "Traefik không tới được app" ⇒ rất dễ đi sửa nhầm cổng/mạng.
#   Tìm tên THẬT trên VPS:
#     docker inspect traefik --format '{{json .Config.Cmd}}' | tr ',' '\n' | grep -i certresolvers
TRAEFIK_CERTRESOLVER=

# ⚠️ `SESSION_SECRET` ở mục "Phiên đăng nhập" phía TRÊN phải được ĐỔI thành chuỗi ngẫu nhiên thật
#    trước khi deploy (giá trị trong tệp này là chuỗi MẪU, ai cũng biết ⇒ giả mạo được phiên):
#      node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#    ⚠️ KHÔNG khai lại `SESSION_SECRET` ở đây: hai dòng cùng tên trong một tệp `.env` là mơ hồ.
#
# ⚠️ KHÔNG cần khai `NODE_ENV`, `COOKIE_SECURE`, `PUBLIC_ORIGIN`, `LOG_LEVEL`, `HOST`, `PORT`,
#    `DB_PATH` cho production: `docker-compose.yml` GHI ĐÈ TẤT CẢ (khối `environment`), và
#    `environment` THẮNG `env_file`. Nhờ vậy dù tệp này còn giá trị DEV thì container vẫn nhận
#    đúng giá trị production — đây là chốt chặn cho S1/S2/S5.
